rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.userId is string &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 50 &&
             data.bestScore is int &&
             data.bestScore >= 0 &&
             data.currentLevel is int &&
             data.currentLevel >= 1 &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidLeaderboard(data) {
      return data.userId is string &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 50 &&
             data.score is int &&
             data.score >= 0 &&
             (data.mode == "classic" || data.mode == "time_attack" || data.mode == "daily") &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidRoom(data) {
      return data.id is string &&
             data.hostId is string &&
             data.hostName is string &&
             (data.status == "waiting" || data.status == "playing" || data.status == "finished") &&
             data.hostScore is int &&
             data.guestScore is int &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) &&
                               request.resource.data.userId == userId &&
                               isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /leaderboard/{entryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                               request.resource.data.userId == request.auth.uid &&
                               isValidLeaderboard(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /multiplayer_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.hostId == request.auth.uid &&
                       isValidRoom(request.resource.data);
      allow update: if isAuthenticated() &&
                       (resource.data.hostId == request.auth.uid ||
                        resource.data.guestId == request.auth.uid ||
                        (resource.data.status == "waiting" && request.resource.data.guestId == request.auth.uid)) &&
                       isValidRoom(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;
    }
  }
}
